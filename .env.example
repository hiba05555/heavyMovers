# Copy to .env.local for local development. Never commit real values.

# Which brand config to build: heavymovers (default) | patientmovers
SITE=heavymovers

# Public base URL (canonicals, sitemap, OG images). Optional: on Vercel the project's
# production URL is used automatically; set this once a custom domain is live.
# SITE_URL=https://heavymovers.com.au

# true on demo/preview deployments: noindex meta + X-Robots-Tag + robots.txt "Disallow: /"
# Build-time flag — change it, then redeploy.
DEMO_NOINDEX=true

# Only for `npm run gen:copy` (local script, never needed by the website at runtime).
# Without a key the script runs as a dry run.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
